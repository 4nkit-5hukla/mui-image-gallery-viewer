{
  "name": "mui-image-gallery-viewer",
  "version": "1.0.0",
  "description": "A production-grade image gallery viewer component using MUI with configurable rail positioning, pagination, and multiple transition effects",
  "type": "module",
  "main": "./dist/mui-image-gallery-viewer.es.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/mui-image-gallery-viewer.es.js"
    }
  },
  "keywords": [
    "react",
    "mui",
    "material-ui",
    "image",
    "gallery",
    "viewer",
    "carousel",
    "pagination",
    "typescript"
  ],
  "author": "Ankit Shukla <shobhit@easysocial.io>",
  "license": "MIT",
  "homepage": "https://github.com/ankit-shukla/mui-image-gallery-viewer",
  "repository": {
    "type": "git",
    "url": "https://github.com/ankit-shukla/mui-image-gallery-viewer"
  },
  "bugs": {
    "url": "https://github.com/ankit-shukla/mui-image-gallery-viewer/issues"
  },
  "peerDependencies": {
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "@mui/material": "^5.14.0 || ^6.0.0",
    "@emotion/react": "^11.0.0",
    "@emotion/styled": "^11.0.0"
  },
  "dependencies": {
    "framer-motion": "^11.0.0 || ^12.0.0"
  },
  "devDependencies": {
    "@mui/icons-material": "^5.14.0",
    "@storybook/addon-docs": "^8.0.0",
    "@storybook/addon-interactions": "^8.0.0",
    "@storybook/addon-links": "^8.0.0",
    "@storybook/addon-onboarding": "^8.0.0",
    "@storybook/blocks": "^8.0.0",
    "@storybook/react": "^8.0.0",
    "@storybook/react-vite": "^8.0.0",
    "@testing-library/jest-dom": "^6.1.0",
    "@testing-library/react": "^14.0.0",
    "@testing-library/user-event": "^14.0.0",
    "@types/node": "^20.0.0",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "@vitest/coverage-v8": "^0.34.0",
    "eslint": "^8.0.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-jsx-a11y": "^6.8.0",
    "eslint-plugin-react": "^7.33.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-storybook": "^0.6.0",
    "husky": "^8.0.0",
    "prettier": "^3.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "storybook": "^8.0.0",
    "standard-version": "^9.0.0",
    "typescript": "^5.0.0",
    "vite": "^5.0.0",
    "vite-plugin-dts": "^5.1.0",
    "vitest": "^0.34.0"
  },
  "scripts": {
    "build": "npm run lint && npm run test -- run && vite build",
    "build:fast": "vite build",
    "dev": "vite",
    "lint": "npx tsc --noEmit && eslint src",
    "lint:fix": "npm run lint -- --fix",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "coverage": "vitest run --coverage",
    "release": "standard-version",
    "release:major": "standard-version --release-as major",
    "release:minor": "standard-version --release-as minor",
    "release:patch": "standard-version --release-as patch",
    "prepare": "husky install"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
